        {"id": "partner_hiv", "dak": "ANC.B6.DE156-DE161", "type": "single", "label": "Partner's HIV status (as she reports it)", "sensitive": true,
         "say": {"en": "Does she know her partner's HIV status? Ask privately.", "kri": "", "yo": ""},
         "options": [{"value": "positive", "label": "Positive"}, {"value": "negative", "label": "Negative"}, {"value": "unknown", "label": "Not known"}, {"value": "no_partner", "label": "No partner"}]}
