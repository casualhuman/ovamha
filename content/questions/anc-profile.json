         "options": [{"value": "none", "label": "None"}, {"value": "primary", "label": "Primary"}, {"value": "secondary", "label": "Secondary"},
                     {"value": "higher", "label": "College or university"}, {"value": "unknown", "label": "Don't know"}]},
        {"id": "occupation", "dak": "ANC.B6.DE7-DE13", "type": "multi", "label": "Work", "optional": true,
         "say": {"en": "What work does she do?", "kri": "", "yo": ""},
         "options": [{"value": "farming", "label": "Farming"}, {"value": "trading", "label": "Trading or market"}, {"value": "formal", "label": "Salaried job"},
